{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true, // חשוב לדיבוג
    "resolveJsonModule": true, // תמיכה בייבוא קבצי JSON
    "moduleResolution": "node" // שיפור רזולוציית המודולים
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

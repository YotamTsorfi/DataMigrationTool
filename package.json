{
  "name": "carmelton_typescript",
  "version": "1.0.0",
  "description": "WS - Transfer data via restApi Or ODBC to Priority",
  "main": "index.js",
  "scripts": {
    "generate-vehicles": "ts-node src/scripts/generateVehicles.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node dist/index.js",
    "start:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node dist/index.js",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "dev:debug": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048 --inspect\" nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "memory:status": "node -e \"console.log(process.memoryUsage())\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "postbuild": "copy .env dist\\.env || cp .env dist/.env"
  },
  "keywords": [],
  "author": "Yotam Tsorfy Shaked",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/mssql": "^9.1.7",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mssql": "^11.0.1"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "node -r ts-node/register src/index.ts",
    "ext": "ts"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
